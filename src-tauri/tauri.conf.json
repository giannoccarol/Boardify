{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boardify",
  "version": "0.1.0",
  "identifier": "com.boardify.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "shelf",
        "title": "Boardify Shelf",
        "url": "/?view=shelf",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "library",
        "title": "Boardify Library",
        "url": "/?view=library",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "shadow": false,
        "backgroundColor": "#0c0c0e"
      },
      {
        "label": "settings",
        "title": "Boardify Settings",
        "url": "/?view=settings",
        "width": 520,
        "height": 680,
        "minWidth": 420,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "shadow": false,
        "backgroundColor": "#0c0c0e"
      },
      {
        "label": "capture",
        "title": "Boardify Capture",
        "url": "/?view=capture",
        "width": 480,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Clipboard visuale per Linux",
    "longDescription": "Boardify salva clipboard e screenshot in una history visuale, raggruppata per tipo, app e categorie."
  }
}
